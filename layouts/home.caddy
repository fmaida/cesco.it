{{- /* Template delle regole di Caddy: Hugo lo pubblica come /.caddy (formato
  "caddy" in hugo.yaml, solo dalla home italiana). È testo di Caddy normale;
  l'unico segnaposto è l'alias WebFinger, preso da params.yaml. */ -}}
# Regole di Caddy per cesco.it, generate da Hugo (layouts/home.caddy) nella
# radice della cartella di deploy.
#
# Il Caddyfile del server le include dentro il blocco del sito, per esempio:
#
#   cesco.it {
#       root * /var/www/cesco.it
#       import /var/www/cesco.it/.caddy
#       file_server
#   }
#
# Caddy legge i file importati solo all'avvio: dopo averli cambiati serve
# "caddy reload" (o "systemctl reload caddy") sul server.

# Questo file non deve essere scaricabile dal sito
@caddy_regole path /.caddy
respond @caddy_regole 404

# WebFinger (RFC 7033): chi cerca acct:{{ site.Params.fediverse.alias }} nel fediverso
# trova l'account Mastodon. La risposta è il file /.well-known/webfinger
# (generato da Hugo); per ogni altro "resource" (o senza) si risponde 404.
# file_server accetta solo GET e HEAD (gli altri metodi ricevono 405).
@webfinger path /.well-known/webfinger
header @webfinger {
	Content-Type "application/jrd+json; charset=utf-8"
	Access-Control-Allow-Origin "*"
}
@webfinger_sconosciuto {
	path /.well-known/webfinger
	not query resource=acct:{{ site.Params.fediverse.alias }}
}
respond @webfinger_sconosciuto 404

# Bluesky: il file /.well-known/atproto-did contiene il DID dell'account e
# permette di usare il dominio come handle (@cesco.it).
header /.well-known/atproto-did Content-Type "text/plain; charset=utf-8"

# Sitemap per lingua che Hugo pubblica comunque: vale quella unica alla
# radice (layouts/sitemapindex.xml), perché /it/sitemap.xml non potrebbe
# elencare le pagine italiane, che stanno fuori da /it/.
redir /it/sitemap.xml /sitemap.xml permanent
redir /en/sitemap.xml /sitemap.xml permanent

# Vecchio feed RSS del sito Flask
redir /rss /blog/index.xml permanent
redir /rss/ /blog/index.xml permanent

# Vecchi file statici serviti sotto /static/ (es. /static/downloads/cv.pdf)
@vecchio_static path_regexp vecchio_static ^/static/(.*)$
redir @vecchio_static /{re.vecchio_static.1} permanent

# Codici QR corti: /<4 caratteri A-Z 2-9> rimanda alla destinazione scritta
# in "qr" di params.yaml, con un 302 (la destinazione si può cambiare).
# Maiuscole e minuscole non contano: il matcher "path" di Caddy non le
# distingue, quindi /ab23, /AB23 e /Ab23 sono lo stesso codice.
{{- /* Gli indirizzi di 4 caratteri a-z 2-9 alla radice sono riservati
  ai QR: una pagina con un percorso così ferma la build, a parte le
  eccezioni qui sotto (pagine che esistevano già prima della regola). Tutti
  i confronti sono in minuscolo, come quelli di Caddy. */}}
{{- $eccezioni := slice "/blog/" }}
{{- $pagine := slice }}
{{- range hugo.Sites }}
  {{- range .Pages }}
    {{- with .RelPermalink | lower }}
      {{- $pagine = $pagine | append . }}
      {{- if and (findRE `^/[a-z2-9]{4}/$` .) (not (in $eccezioni .)) }}
        {{- errorf "QR: la pagina %s ha un indirizzo di 4 caratteri a-z 2-9, riservato ai codici QR (vedi CLAUDE.md, sezione Caddy)" . }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- /* file e cartelle alla radice di static/ */}}
{{- $statici := slice }}
{{- range os.ReadDir "static" }}
  {{- $statici = $statici | append (lower .Name) }}
{{- end }}
{{- range $chiave, $destinazione := site.Params.qr }}
  {{- /* Hugo mette già in minuscolo i nomi dei params: AbCd diventa abcd */}}
  {{- $codice := lower $chiave }}
  {{- if not (findRE `^[a-z2-9]{4}$` $codice) }}
    {{- errorf "params.yaml: il codice QR %q deve essere di 4 caratteri tra a-z e 2-9 (niente 0 e 1)" $codice }}
  {{- end }}
  {{- if not (findRE `^(https?://|/)` (string $destinazione)) }}
    {{- errorf "params.yaml: la destinazione del codice QR %q deve iniziare con https://, http:// o /, non %q" $codice $destinazione }}
  {{- end }}
  {{- if or (in $pagine (printf "/%s/" $codice)) (in $statici $codice) }}
    {{- errorf "params.yaml: il codice QR %q coincide con una pagina o un file del sito" $codice }}
  {{- end }}
@qr_{{ $codice }} path /{{ $codice }} /{{ $codice }}/
redir @qr_{{ $codice }} {{ $destinazione }} temporary
{{- end }}

# Pagina 404 del sito (in inglese sotto /en/). Richiede Caddy 2.8 o successivo.
handle_errors 404 {
	handle /en/* {
		rewrite * /en/404.html
		file_server
	}
	handle {
		rewrite * /404.html
		file_server
	}
}
